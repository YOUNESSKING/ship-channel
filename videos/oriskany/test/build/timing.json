{
 "voice": "am_michael",
 "speed": 0.95,
 "lead": 0.6,
 "duration": 58.995,
 "chunks": [
  {
   "id": "c01",
   "start": 0.6,
   "end": 3.309,
   "text": "Twenty-four miles off the Florida coast,"
  },
  {
   "id": "c02",
   "start": 3.459,
   "end": 5.785,
   "text": "two hundred and twelve feet down,"
  },
  {
   "id": "c03",
   "start": 5.935,
   "end": 8.239,
   "text": "lies an American aircraft carrier."
  },
  {
   "id": "c04",
   "start": 8.589,
   "end": 10.807,
   "text": "Nearly nine hundred feet long."
  },
  {
   "id": "c05",
   "start": 11.107,
   "end": 12.686,
   "text": "She fought in two wars."
  },
  {
   "id": "c06",
   "start": 13.136,
   "end": 14.672,
   "text": "No enemy sank her."
  },
  {
   "id": "c07",
   "start": 15.022,
   "end": 16.985,
   "text": "The United States Navy did."
  },
  {
   "id": "c08",
   "start": 17.235,
   "end": 18.429,
   "text": "On purpose."
  },
  {
   "id": "c09",
   "start": 19.029,
   "end": 21.525,
   "text": "On May seventeenth, two thousand six,"
  },
  {
   "id": "c10",
   "start": 21.675,
   "end": 25.494,
   "text": "engineers set off explosive charges inside her hull."
  },
  {
   "id": "c11",
   "start": 25.944,
   "end": 27.651,
   "text": "Thirty-seven minutes later,"
  },
  {
   "id": "c12",
   "start": 27.801,
   "end": 28.931,
   "text": "she was gone."
  },
  {
   "id": "c13",
   "start": 29.531,
   "end": 31.217,
   "text": "It had taken three years"
  },
  {
   "id": "c14",
   "start": 31.317,
   "end": 33.322,
   "text": "and about twenty million dollars"
  },
  {
   "id": "c15",
   "start": 33.422,
   "end": 35.214,
   "text": "just to get her ready to sink."
  },
  {
   "id": "c16",
   "start": 35.814,
   "end": 41.681,
   "text": "So why would the Navy pay millions to send one of its own carriers to the bottom of the sea,"
  },
  {
   "id": "c17",
   "start": 41.831,
   "end": 43.303,
   "text": "instead of keeping her,"
  },
  {
   "id": "c18",
   "start": 43.453,
   "end": 45.799,
   "text": "or simply cutting her up for scrap?"
  },
  {
   "id": "c19",
   "start": 46.399,
   "end": 49.343,
   "text": "The answer starts with what was hidden inside her."
  },
  {
   "id": "c20",
   "start": 49.943,
   "end": 55.938,
   "text": "And this month, a second famous American ship is scheduled to go down off the same coast,"
  },
  {
   "id": "c21",
   "start": 56.088,
   "end": 57.795,
   "text": "for the very same reason."
  }
 ]
}